{
  "name": "vce-revision-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:index": "node scripts/build-subject-index.mjs",
    "cards:fill": "node scripts/write-missing-cue-cards.mjs",
    "predev": "npm run build:index",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run build:index",
    "build": "vite build",
    "app:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-desktop.ps1",
    "app:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run build:index",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.0.0"
  }
}
